# ========================================================
# RAGE CLOUD - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# NEVER commit production credentials or private keys to git!
# Copy this file to .env and fill in the values for your deployment.

# Platform Environment (development | staging | production)
APP_ENV=development
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-at-least-32-chars
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://rage_user:rage_password@localhost:5432/rage_cloud
# Fallback to sqlite for rapid local demo if Postgres is not running:
# DATABASE_URL=sqlite+aiosqlite:///./rage_cloud.db

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0

# Google Cloud & Google Drive Storage Backend
# Create a project at https://console.cloud.google.com/
# Enable the Google Drive API v3
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_PROJECT_ID=rage-cloud-mvp
# Folder ID in Google Drive where RAGE Cloud files will be stored
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz123456
# Base64 encoded JSON string or absolute path to your Google Service Account key file:
GOOGLE_SERVICE_ACCOUNT_JSON=

# JWT Authentication
JWT_SECRET=rage-cloud-jwt-super-secret-key-min-32-characters
JWT_ACCESS_EXPIRE=60 # minutes
JWT_REFRESH_EXPIRE=10080 # minutes (7 days)
JWT_ALGORITHM=HS256

# Storage & Upload Limits
# Max upload size in bytes (1073741824 = 1GB)
MAX_UPLOAD_SIZE=1073741824
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,mp4,webm,mov,mkv,zip,rar,7z,tar,gz,pdf,docx,xlsx,pptx,txt,iso,apk,exe,bin
STORAGE_BACKEND=google_drive # Options: google_drive, local, s3

# Financial & Revenue Engine Defaults (Configurable via Admin Dashboard)
CREATOR_REVENUE_PERCENT=60.0
PLATFORM_REVENUE_PERCENT=40.0
TEAM_DEFAULT_SPLIT_PERCENT=30.0
REFERRAL_REWARD=50.0 # Reward credited per qualified referral
MIN_WITHDRAWAL_AMOUNT=100.0 # Minimum balance to request withdrawal

# Advertisement System
AD_PROVIDER=mock # Options: adsense, ad_manager, mock
AD_NETWORK_PUBLISHER_ID=ca-pub-0000000000000000

# Fraud Detection Engine Thresholds
MAX_DOWNLOADS_PER_IP_PER_HOUR=20
BOT_DETECTION_STRICT_MODE=true
QUALIFIED_DOWNLOAD_MIN_SECONDS=3
QUALIFIED_VIDEO_MIN_WATCH_SECONDS=10
