# Application Environment
APP_NAME=RAGE Cloud
APP_ENV=production
SECRET_KEY=change-this-to-a-secure-random-32-char-string
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (Railway will automatically provide DATABASE_URL if you add a PostgreSQL plugin)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/dbname

# CORS (Specify your Netlify domain in production)
# CORS_ORIGINS=["https://your-rage-cloud.netlify.app", "*"]

# Google Drive Storage (5TB Storage Setup)
STORAGE_BACKEND=google_drive
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_DRIVE_FOLDER_ID=
# In Railway/Render, paste the entire JSON string from google_token.json below:
GOOGLE_TOKEN_JSON=

# JWT Secrets
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60

# Revenue & Monetization Engine
CREATOR_REVENUE_PERCENT=60.0
PLATFORM_REVENUE_PERCENT=40.0
TEAM_DEFAULT_SPLIT_PERCENT=30.0
REFERRAL_REWARD=50.0
MIN_WITHDRAWAL_AMOUNT=100.0
AD_PROVIDER=mock
